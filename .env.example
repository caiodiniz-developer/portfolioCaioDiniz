# Copy this file to .env.local and fill in your values.
# Everything here is OPTIONAL — the site runs fine with none of it set.

# ── Guestbook — Supabase (free tier: supabase.com) ──────────────────────────
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON=your-anon-public-key-here

# ── Analytics ───────────────────────────────────────────────────────────────
# Leave BOTH blocks empty to disable tracking entirely (the default).
# Neither provider uses cookies, so no consent banner is needed.

# Option A — Umami (recommended, self-hosted, free)
#   Deploy: https://umami.is/docs/install  (Railway/Vercel + any Postgres)
#   Then add your site in the dashboard and copy its Website ID.
VITE_UMAMI_URL=
VITE_UMAMI_ID=

# Option B — Plausible (self-hosted community edition)
#   Deploy: https://github.com/plausible/community-edition
VITE_PLAUSIBLE_URL=
VITE_PLAUSIBLE_DOMAIN=

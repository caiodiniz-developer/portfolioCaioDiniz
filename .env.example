# Copy this file to .env.local and fill in your values.
# Everything here is OPTIONAL — the site runs fine with none of it set.

# ── Guestbook — Supabase (free tier: supabase.com) ──────────────────────────
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON=your-anon-public-key-here

# ── Analytics ───────────────────────────────────────────────────────────────
# Leave every block empty to disable tracking entirely (the default).
# The first one that is filled in wins; the others are ignored.

# Option A — Google Analytics 4  ← currently in use
#   Admin → Data streams → your stream → "Measurement ID" (starts with G-)
#   NOTE: unlike the options below, GA4 sets cookies, so an LGPD/GDPR consent
#   banner is legally expected for EU/BR visitors.
VITE_GA_ID=

# Option B — Umami (self-hosted, free, cookieless)
#   Deploy: https://umami.is/docs/install  (Railway/Vercel + any Postgres)
#   Then add your site in the dashboard and copy its Website ID.
VITE_UMAMI_URL=
VITE_UMAMI_ID=

# Option C — Plausible (self-hosted community edition, cookieless)
#   Deploy: https://github.com/plausible/community-edition
VITE_PLAUSIBLE_URL=
VITE_PLAUSIBLE_DOMAIN=
